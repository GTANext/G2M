{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G2M",
  "version": "0.0.1",
  "identifier": "com.gtamodx.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTAMODX Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "G2M",
        "url": "splashscreen.html",
        "width": 420,
        "height": 320,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.gtamodx.com/g2m/update/{{target}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo.png",
      "icons/favicon.ico"
    ]
  }
}
