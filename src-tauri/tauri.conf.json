{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G2M",
  "version": "0.0.1",
  "identifier": "com.gtamodx.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GTAMODX Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.gtamodx.com/g2m/update/{{target}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo.png",
      "icons/favicon.ico"
    ]
  }
}
