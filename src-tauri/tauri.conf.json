{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G2M",
  "identifier": "com.gtamodx.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTAMODX Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "G2M",
        "url": "splashscreen.html",
        "width": 440,
        "height": 420,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "resources/"
    ],
    "icon": [
      "icons/logo.png",
      "icons/favicon.ico"
    ]
  }
}
